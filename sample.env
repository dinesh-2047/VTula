# Copy this file to `.env.local` and fill in real values.
#
# `.env.local` is gitignored; this file is the tracked reference and must never
# contain a real credential. Every variable the code actually reads is listed
# here — `grep -rn "process.env." src/ scripts/` is the check.
#
# Required to boot at all: MONGODB_URI, NEXTAUTH_SECRET, CERT_SIGNING_SECRET.
# Everything else degrades: the feature it powers reports itself as unconfigured
# rather than pretending to work.


# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# The database name at the end of the path is part of the URI. `npm run migrate`
# prints the name it connected to before touching anything, so a mistyped
# database is caught before it is written to.
MONGODB_URI=mongodb+srv://your_username:your_password@cluster.mongodb.net/vtula


# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_super_secret_key_here

# The public origin. Certificate QR codes encode `${NEXTAUTH_URL}/verify/<certNo>`
# and are printed onto stickers, so changing this after certificates have been
# issued leaves those QR codes pointing at the old host.
NEXTAUTH_URL=http://localhost:3000


# ---------------------------------------------------------------------------
# Payments (Razorpay)
# ---------------------------------------------------------------------------

# The key id is sent to the browser by design — that is what `NEXT_PUBLIC_` means.
# The secret never is: it verifies the payment signature server-side.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key


# ---------------------------------------------------------------------------
# Certificate signing
# ---------------------------------------------------------------------------

# Mandatory. `src/lib/utils.ts` throws rather than falling back to a default,
# because a shared fallback secret makes every signature in the system forgeable
# by anyone who has read the source while still showing "valid" in the UI.
CERT_SIGNING_SECRET=your_vtula_cert_signing_secret_key

# Optional, defaults to `v1`. Stored on each certificate as `signatureKeyId`, so
# that rotating CERT_SIGNING_SECRET stays auditable: bump this at the same time
# and every certificate records which key signed it. Certificates signed with an
# older key keep their old id and remain verifiable against it.
CERT_SIGNING_KEY_ID=v1


# ---------------------------------------------------------------------------
# File storage (Cloudinary)
# ---------------------------------------------------------------------------

# Optional. Without it, uploaded evidence is stored in the database and served
# through `/api/documents/[id]/content` behind the same authorisation checks.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


# ---------------------------------------------------------------------------
# Email (SMTP)
# ---------------------------------------------------------------------------

# Optional. Unset, the settings page reports email as unconfigured instead of
# silently dropping expiry reminders.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here

# Optional envelope sender. Falls back to `VTULA <EMAIL_USER>`. Set it when the
# authenticating mailbox differs from the address the department sends as.
EMAIL_FROM=VTULA <no-reply@your-domain.gov.in>


# ---------------------------------------------------------------------------
# WhatsApp (Meta Cloud API)
# ---------------------------------------------------------------------------

WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token


# ---------------------------------------------------------------------------
# SMS and phone verification (Twilio)
# ---------------------------------------------------------------------------

TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Twilio Verify handles the OTP codes for phone verification.
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid

# Separate from Verify: the sending number for plain SMS notifications. Without
# it the settings page shows SMS as unavailable, because Twilio being configured
# for OTP does not mean there is a number to send from.
TWILIO_SMS_FROM=+15551234567

# Development convenience. Outside production the fixed OTP `123456` is accepted
# so phone verification can be exercised without a Twilio account; set this to
# `false` to require a real code locally. It has no effect in production — the
# mock path is off there unconditionally, whatever this says.
VTULA_ALLOW_MOCK_OTP=true


# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------

# Bearer credential for `POST /api/alerts/run`, the sweep that issues expiry
# reminders and marks lapsed certificates. Point a scheduler at it:
#
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" https://host/api/alerts/run
#
# Leave it unset and the unattended path is refused outright rather than left
# open — but then nothing runs the sweep, so a certificate can lapse with no
# warning ever reaching the business. An admin can still run it by hand from
# Settings.
CRON_SECRET=your_long_random_scheduler_secret
